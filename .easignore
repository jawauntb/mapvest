# .easignore at the git root — controls the EAS build tarball.
# We're building apps/ios but need the monorepo context.
# Anchor root-only drops with a leading slash. Unanchored `build/` / `scripts/`
# match every nested directory with that name (eas-cli/issues/3198).

# Drop other monorepo apps that aren't needed for the iOS build.
/apps/api/
/apps/landing/

# Drop root-level node_modules and bun caches (they'll be reinstalled).
node_modules/
.bun/
/bun.lock
.turbo/
.next/
/dist/
/build/
/out/

# Native build artifacts — EAS runs pod install / xcodebuild itself.
# Including these bloats the tarball (120MB → 306MB) and can corrupt unpack.
/apps/ios/ios/Pods/
/apps/ios/ios/build/
/apps/ios/ios/DerivedData/
**/xcuserdata/
**/*.xcuserstate

# Drop docs / postman that just bloat the tarball
/docs/
postman.json
openapi.yaml
IMPLEMENTATION_PLAN.md
/scripts/

# Cursor / VS Code / IDE cruft
.cursor/
.vscode/
.idea/

# Local secrets
.env
.env.*
!.env.example
/apps/ios/credentials.json
/apps/ios/credentials/
/apps/ios/*.p12
/apps/ios/*.mobileprovision
/apps/ios/*.p8

# System
.DS_Store
*.log
*.ipa
/apps/ios/*.ipa

# Keep nested EAS app metadata last so these win over any prior ignore.
# The worker cwd is the git root and looks for apps/ios/package.json.
!/apps/ios/package.json
!/apps/ios/package-lock.json
!/apps/ios/bun.lock
!/apps/ios/app.json
!/apps/ios/eas.json
