# All real secrets live in Doppler `mapvest/dev` (personal workplace) — names only.
# Never commit real values. See docs/SECRETS.md.

# Multimodal LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Search
EXA_API_KEY=

# Vision fallback
GEMINI_API_KEY=

# Google Maps / Places (server-side)
GOOGLE_MAPS_API_KEY=

# API
PORT=3001
NODE_ENV=development

# Billing (names only — real values in Doppler)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
APPLE_IAP_PRODUCT_ID=mapvest_pro_monthly
APPLE_BUNDLE_ID=com.mapvest.app
GOOGLE_PLAY_PRODUCT_ID=

# iOS: never place raw secrets here — the app reads a signed short-lived token
# from /v1/session at runtime. See docs/SECRETS.md.
