# All real secrets live in Doppler `cofounder/dev` — this file is only for names.
# Never commit real values. See docs/SECRETS.md.

# Multimodal LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Search
EXA_API_KEY=

# Vision fallback
GEMINI_API_KEY=

# Google Maps / Places (server-side)
GOOGLE_MAPS_API_KEY=

# API
PORT=3001
NODE_ENV=development

# iOS: never place raw secrets here — the app reads a signed short-lived token
# from /v1/session at runtime. See docs/SECRETS.md.
