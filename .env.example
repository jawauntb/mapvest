# All real secrets live in Doppler `shared/dev_personal` (personal workplace) — names only.
# Never commit real values. See docs/SECRETS.md.

# Multimodal LLM
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Search
EXA_API_KEY=

# Vision fallback
GEMINI_API_KEY=

# Google Maps / Places (server-side)
GOOGLE_MAPS_API_KEY=

# API
PORT=3001
NODE_ENV=development

# Billing (names only — real values in Doppler)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
APPLE_IAP_PRODUCT_ID=mapvest_pro_monthly
APPLE_BUNDLE_ID=com.mapvest.app
GOOGLE_PLAY_PRODUCT_ID=

# iOS: never place raw secrets here — the app reads a signed short-lived token
# from /v1/session at runtime. See docs/SECRETS.md.
# Market data routing. Keep credentials in Doppler; these names are safe to
# copy into a local placeholder only.
MARKET_DATA_PRIMARY=massive
# Backward-compatible alias; use MARKET_DATA_PRIMARY for new deployments.
MARKET_DATA_PROVIDER=
MARKET_DATA_FALLBACK_PROVIDER=yahoo
MASSIVE_API_KEY=
# Shared Massive flat-file credentials (not required by the REST adapter yet)
MASSIVE_S3_FLAT_FILE_ACCESS_KEY_ID=
MASSIVE_S3_FLAT_FILE_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=
MASSIVE_S3_BUCKET=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_MARKET_DATA_FRESHNESS=
MASSIVE_CORPORATE_EVENTS_ENABLED=0
