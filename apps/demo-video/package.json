{
  "name": "@mapvest/demo-video",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "launch:plan": "bun scripts/launch-video.ts plan",
    "launch:prepare": "bun scripts/launch-video.ts prepare",
    "music:generate": "bun scripts/launch-video.ts music",
    "music:alternatives": "bun scripts/music-alternatives.ts generate",
    "music:alternatives:verify": "bun scripts/music-alternatives.ts verify",
    "render:all": "bun scripts/launch-video.ts render",
    "render:verify": "bun scripts/launch-video.ts verify",
    "render:portrait:music": "remotion render src/index.ts MapvestLaunchPortraitMusic out/mapvest-launch-portrait-music.mp4 --codec=h264 --audio-codec=aac --crf=18 --color-space=bt709",
    "render:portrait:silent": "remotion render src/index.ts MapvestLaunchPortraitSilent out/mapvest-launch-portrait-silent.mp4 --codec=h264 --crf=18 --color-space=bt709 --muted",
    "render:square:music": "remotion render src/index.ts MapvestLaunchSquareMusic out/mapvest-launch-square-music.mp4 --codec=h264 --audio-codec=aac --crf=18 --color-space=bt709",
    "render:square:silent": "remotion render src/index.ts MapvestLaunchSquareSilent out/mapvest-launch-square-silent.mp4 --codec=h264 --crf=18 --color-space=bt709 --muted",
    "render:smoke": "remotion still src/index.ts MapvestLaunchPortraitSilent out/smoke-frame.png --frame=900 --scale=0.25"
  },
  "dependencies": {
    "@mapvest/core": "workspace:*",
    "@remotion/media": "4.0.518",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.518",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@types/bun": "^1.4.0",
    "@types/react": "19.1.10",
    "typescript": "^5.6.3"
  }
}
