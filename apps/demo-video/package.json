{
  "name": "@mapvest/demo-video",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:portrait": "remotion render src/index.ts MapvestTweetPortrait out/mapvest-tweet-portrait.mp4 --codec=h264 --crf=18",
    "render:square": "remotion render src/index.ts MapvestTweetSquare out/mapvest-tweet-square.mp4 --codec=h264 --crf=18",
    "render:smoke": "remotion still src/index.ts MapvestTweetPortrait out/smoke-frame.png --frame=405 --scale=0.25"
  },
  "dependencies": {
    "@remotion/media": "4.0.518",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@types/react": "19.1.10",
    "typescript": "^5.6.3"
  }
}
