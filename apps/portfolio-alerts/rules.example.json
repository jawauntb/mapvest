{
  "version": 1,
  "timezone": "America/New_York",
  "runHour": 12,
  "budget": { "startValue": 50000, "maxLoss": 20000 },
  "reauthWarnHours": 48,
  "fridaySummary": { "enabled": true, "channels": ["email", "sms"] },
  "rules": [
    {
      "id": "account-floor",
      "title": "Account below $40k",
      "when": { "left": { "metric": "account_value" }, "op": "<", "right": 40000 },
      "action": "trim the tech sleeve (AAPL, MSFT) by half into a T-bill ETF",
      "show": [{ "metric": "sleeve_value", "symbols": ["AAPL", "MSFT"] }]
    },
    {
      "id": "aapl-150",
      "title": "AAPL close below $150",
      "when": { "left": { "metric": "close", "symbol": "AAPL" }, "op": "<", "right": 150 },
      "action": "add a small index hedge"
    },
    {
      "id": "qqq-50dma",
      "title": "QQQ below its 50-day SMA",
      "when": {
        "left": { "metric": "close", "symbol": "QQQ" },
        "op": "<",
        "right": { "metric": "sma", "symbol": "QQQ", "period": 50 }
      },
      "action": "add a small index hedge"
    },
    {
      "id": "position-diff",
      "title": "Positions changed",
      "when": { "positions_changed": true },
      "action": "confirm the changes were intended"
    },
    {
      "id": "example-composite",
      "title": "Composite example (disabled)",
      "enabled": false,
      "owner": "example",
      "repeat": "on_trip",
      "channels": ["email"],
      "when": {
        "all": [
          {
            "left": { "metric": "pct_change", "symbol": "QQQ", "days": 5 },
            "op": "<=",
            "right": -5
          },
          {
            "any": [
              { "left": { "metric": "budget_used_pct" }, "op": ">=", "right": 50 },
              {
                "left": { "metric": "sleeve_weight_pct", "symbols": ["AAPL", "MSFT"] },
                "op": ">",
                "right": 40
              }
            ]
          }
        ]
      },
      "action": "example: review concentration after a 5% weekly drop"
    }
  ]
}
