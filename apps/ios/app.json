{
  "expo": {
    "name": "Mapvest",
    "slug": "mapvest",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mapvest",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mapvest.app",
      "buildNumber": "95",
      "appleTeamId": "58877MPK38",
      "infoPlist": {
        "NSCameraUsageDescription": "Mapvest uses your camera to identify brands you see in the wild and map them to public tickers.",
        "NSLocationWhenInUseUsageDescription": "Mapvest uses your location to show investable brands near you on the map.",
        "NSPhotoLibraryUsageDescription": "Mapvest may attach a captured photo to an identification request.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "$IOS_GOOGLE_MAPS_API_KEY"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mapvest.app.widget"
        ]
      }
    },
    "android": {
      "package": "com.mapvest.app",
      "config": {
        "googleMaps": {
          "apiKey": "$ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mapvest to access your camera to identify brands.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mapvest uses your location to show investable brands near you on the map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Share to Mapvest",
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NearbyWidget",
              "label": "Mapvest Nearby",
              "description": "Investable brands near you — map + list.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "maxResizeWidth": "300dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": false,
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-font",
      "expo-iap"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e3902302-dff0-4dee-9974-d74166073356"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "owner": "jawauntb"
  }
}
