{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-production-4b27.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-production-4b27.up.railway.app",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "RCT_USE_RN_DEP": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.mapvest.app",
        "appleId": "jawauntb@yahoo.com",
        "appleTeamId": "58877MPK38",
        "ascAppId": "6798832989"
      }
    },
    "preview": {
      "ios": {
        "bundleIdentifier": "com.mapvest.app",
        "appleId": "jawauntb@yahoo.com",
        "appleTeamId": "58877MPK38",
        "ascAppId": "6798832989"
      }
    }
  }
}
