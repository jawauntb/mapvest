# Names only. Real values live in Doppler project `shared` (personal workplace).
# Local development uses `shared/dev_personal`; production uses `shared/prd`.
# Do not put RAILWAY_* platform vars in Doppler.

# Runtime
NODE_ENV=production
PORT=3001
ADMIN_EMAILS=
AUTH_RETURN_CODE=

# Auth / maps JWT
SESSION_SIGNING_KEY=
IOS_MAPS_TOKEN_SIGNING_KEY=

# Data
POSTGRES_URL=
GOOGLE_MAPS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Models + search
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXA_API_KEY=
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Research siblings
DERIVATION_URL=
UNDERLYING_URL=
RESEARCH_CONSOLE_FORWARDED_HOST=
RESEARCH_CONSOLE_SERVICE_TOKEN_READ=
RESEARCH_CONSOLE_SERVICE_TOKEN_MUTATE=

# Stripe (web). Price must match Apple $19.99.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=https://mapvest.app/app
STRIPE_CANCEL_URL=https://mapvest.app/app

# Native IAP. Leave APPLE_IAP_PRODUCT_ID empty until StoreKit TestFlight is on devices.
APPLE_IAP_PRODUCT_ID=
APPLE_BUNDLE_ID=com.mapvest.app
GOOGLE_PLAY_PRODUCT_ID=

# Dev-only mocks. Keep off in prd.
MOCK_PLACES=
MOCK_PLACES_ALLOW_PROD=
ENABLE_PUSH_SCHEDULER=
# Market data (primary provider; credentials are populated in Doppler only)
MARKET_DATA_PRIMARY=massive
# Backward-compatible alias; use MARKET_DATA_PRIMARY for new deployments.
MARKET_DATA_PROVIDER=
MARKET_DATA_FALLBACK_PROVIDER=yahoo
MASSIVE_API_KEY=
# Shared Massive flat-file credentials (not required by the REST adapter yet)
MASSIVE_S3_FLAT_FILE_ACCESS_KEY_ID=
MASSIVE_S3_FLAT_FILE_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=
MASSIVE_S3_BUCKET=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_MARKET_DATA_FRESHNESS=
MASSIVE_CORPORATE_EVENTS_ENABLED=0
