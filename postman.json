{
  "info": {
    "name": "Mapvest API — v0.1.0-alpha.0",
    "description": "Mapvest turns places and objects into investable tickers. All request and response shapes are generated from zod schemas in `packages/core/src/schemas` — never hand-edit `openapi.yaml`.\n\nGenerated from openapi.yaml. Regenerate: `bun run openapi && bun run postman`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "system",
      "description": "Health + system endpoints",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Liveness probe. Returns 200 while the API is accepting traffic."
          }
        }
      ]
    },
    {
      "name": "identify",
      "description": "Photo → investable identification",
      "item": [
        {
          "name": "Identify investable brands from a photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/identify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "identify"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file"
                },
                {
                  "key": "location",
                  "type": "text",
                  "value": "{\"lat\":-90,\"lng\":-180}"
                }
              ]
            },
            "description": "Accepts a multipart image plus optional location. Runs the vision pipeline and returns detected brands with ticker / comparable / ETF annotations. See `packages/vision`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Finds journal for the signed-in user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/finds?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "finds"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Max finds to return. Default 100, capped at 200."
                }
              ]
            },
            "description": "Every successful `/v1/identify` by a signed-in user records the top investable as a find. Returns finds newest-first.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "nearby",
      "description": "Location-driven place lookup",
      "item": [
        {
          "name": "Nearby investable places",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/nearby?lat=0&lng=0&radius=500&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "0"
                },
                {
                  "key": "lng",
                  "value": "0"
                },
                {
                  "key": "radius",
                  "value": "500"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Google Places lookup around a lat/lng, filtered and annotated with tickers/ETFs. Every finance answer includes a `sources: Source[]` array (see AGENTS.md §6).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "widget",
      "description": "Home-screen widget data (iOS WidgetKit / Android App Widget)",
      "item": [
        {
          "name": "Trimmed nearby payload for home-screen widgets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/widget/nearby?lat=0&lng=0&radius=500&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "widget",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "0"
                },
                {
                  "key": "lng",
                  "value": "0"
                },
                {
                  "key": "radius",
                  "value": "500"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Same places cascade + brand join as `/v1/nearby`, capped small (max 12) with quotes attached for up to 6 tickers. Built for the iOS WidgetKit and Android home-screen widgets, which refresh on a timeline rather than on demand. No auth required."
          }
        },
        {
          "name": "Static map PNG for home-screen widgets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/widget/map-snapshot?lat=0&lng=0&radius=500&limit=25&width=0&height=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "widget",
                "map-snapshot"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "0"
                },
                {
                  "key": "lng",
                  "value": "0"
                },
                {
                  "key": "radius",
                  "value": "500"
                },
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "width",
                  "value": "0",
                  "description": "PNG width in px, capped at 640."
                },
                {
                  "key": "height",
                  "value": "0",
                  "description": "PNG height in px, capped at 640."
                }
              ]
            },
            "description": "Server-rendered Google Static Maps PNG with a pin for the origin and one per nearby investable, labeled by ticker. Proxies the request so `GOOGLE_MAPS_API_KEY` never reaches a widget extension (see docs/SECRETS.md). Returns 501 when no key is configured."
          }
        }
      ]
    },
    {
      "name": "finance",
      "description": "Ticker / comparable / ETF resolution",
      "item": [
        {
          "name": "Resolve a private brand to a public comparable + ETF exposure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/resolve-comparable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "resolve-comparable"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"\",\n  \"hintSector\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Given a brand name, returns the closest public comparable, ETF exposures, and cited sources. Confidence is `low` when the pipeline could not cite a source (do not fabricate).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Daily Yahoo price history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/quote-history?symbol=AAPL&period=1mo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "quote-history"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "AAPL"
                },
                {
                  "key": "period",
                  "value": "1mo"
                }
              ]
            },
            "description": "Daily adjusted closes from Yahoo Finance v7 chart for the native Overview price series. Period defaults to `1mo`. Does not invent prices — 502 when history is unavailable."
          }
        },
        {
          "name": "Underlying Analyzer chart image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/chart/{type}?ticker=MCD&period=1mo&month=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "chart",
                "{type}"
              ],
              "query": [
                {
                  "key": "ticker",
                  "value": "MCD"
                },
                {
                  "key": "period",
                  "value": "1mo"
                },
                {
                  "key": "month",
                  "value": "0"
                }
              ]
            },
            "description": "Proxies `POST /api/charts/{type}` on Underlying Analyzer. Period aliases `1m`/`1M` normalize to yfinance `1mo`."
          }
        },
        {
          "name": "Underlying Analyzer snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/analysis/{ticker}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "analysis",
                "{ticker}"
              ]
            },
            "description": "Lightweight stock summary (+ brief when present). Full Anthropic brief via POST /v1/memo."
          }
        },
        {
          "name": "Watchlist cockpit (Underlying Analyzer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/cockpit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "cockpit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tickers\": [\n    \"\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Batch rank for up to 10 tickers via POST /api/watchlists/cockpit."
          }
        },
        {
          "name": "Watchlist alerts digest (Underlying Analyzer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tickers\": [\n    \"\"\n  ],\n  \"maxAlerts\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Alert digest for up to 10 tickers via POST /api/watchlists/alerts."
          }
        },
        {
          "name": "Ticker-bound research brief (Derivation idea-chats)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agent/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"\",\n  \"ticker\": \"\",\n  \"threadId\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Aggregates Derivation Research Console SSE into one article-shaped assistant turn. Product IA: open from ticker Research…; history under Saved → Briefs. Factory/Jobs UI not exposed. Broker orders off."
          }
        },
        {
          "name": "List persisted research brief threads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/agent/threads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent",
                "threads"
              ]
            },
            "description": "Proxies Derivation GET /api/idea-chats. Shown under Saved → Briefs."
          }
        },
        {
          "name": "Get one research brief thread",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/agent/threads/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent",
                "threads",
                "{id}"
              ]
            }
          }
        },
        {
          "name": "Generate a ticker memo (billable)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/memo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "memo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Full research memo for a ticker. Counts against the 50-generation free tier. Returns 402 `quota_exceeded` when the meter is spent."
          }
        }
      ]
    },
    {
      "name": "auth",
      "description": "Passwordless email sign-in",
      "item": [
        {
          "name": "Passwordless email sign-in (magic link)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "session"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts or completes a magic-link session. On first call with `{email}`, an email is dispatched. On second call with `{email, code}`, a session token is returned."
          }
        }
      ]
    },
    {
      "name": "billing",
      "description": "Entitlements + $20/mo subscription checkout",
      "item": [
        {
          "name": "Free-tier remaining + plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/entitlements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "entitlements"
              ]
            },
            "description": "Auth optional. Anonymous callers send `X-Device-Id` so remaining generations can be tracked per device. Mirrors the state `requireGenerationQuota` consumes."
          }
        },
        {
          "name": "Start a $20/mo subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/billing/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "billing",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"web\",\n  \"successUrl\": \"\",\n  \"cancelUrl\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Signed-in only. `platform` selects the charge channel: Stripe Checkout URL for web (and iOS/Android until native product ids are configured), or `apple_iap` / `google_play` product ids once those env vars are set. Clients must not invent payment URLs.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Stripe customer portal (manage / cancel)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/billing/portal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "billing",
                "portal"
              ]
            },
            "description": "Signed-in Stripe subscribers only. Native-store subscribers manage billing in App Store / Play, not here.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Redeem a StoreKit 2 transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/billing/apple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "billing",
                "apple"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signedTransaction\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Signed-in only. Body is the JWS from StoreKit (`purchase.purchaseToken` on iOS). The API verifies Apple's ES256 + x5c chain against Apple Root CA G3, then sets `plan=subscribed`. Native subscribers manage billing in the App Store, not Stripe portal.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "admin",
      "description": "Requires the `admin` scope",
      "item": [
        {
          "name": "Admin: request + cost metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "metrics"
              ]
            },
            "description": "Requires the `admin` scope. Returns rolling counters for identify/nearby/resolve calls and OpenRouter cost telemetry.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin: list users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "users"
              ]
            },
            "description": "Requires the `admin` scope. Returns registered users.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "sessionToken",
      "value": "",
      "type": "string"
    }
  ]
}
