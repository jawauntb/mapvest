        {
          "name": "Static map PNG for home-screen widgets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/widget/map-snapshot?lat=0&lng=0&radius=500&limit=25&width=0&height=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "widget",
                "map-snapshot"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "0"
                },
                {
                  "key": "lng",
                  "value": "0"
                },
                {
                  "key": "radius",
                  "value": "500"
                },
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "width",
                  "value": "0",
                  "description": "PNG width in px, capped at 640."
                },
                {
                  "key": "height",
                  "value": "0",
                  "description": "PNG height in px, capped at 640."
                }
