{
  "info": {
    "name": "Mapvest API — v0.1.0-alpha.0",
    "description": "Mapvest turns places and objects into investable tickers. All request and response shapes are generated from zod schemas in `packages/core/src/schemas` — never hand-edit `openapi.yaml`.\n\nGenerated from openapi.yaml. Regenerate: `bun run openapi && bun run postman`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "system",
      "description": "Health + system endpoints",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Liveness probe. Returns 200 while the API is accepting traffic."
          }
        }
      ]
    },
    {
      "name": "identify",
      "description": "Photo → investable identification",
      "item": [
        {
          "name": "Identify investable brands from a photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/identify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "identify"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file"
                },
                {
                  "key": "location",
                  "type": "text",
                  "value": "{\"lat\":-90,\"lng\":-180}"
                }
              ]
            },
            "description": "Accepts a multipart image plus optional location. Runs the vision pipeline and returns detected brands with ticker / comparable / ETF annotations. See `packages/vision`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Finds journal for the signed-in user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/finds?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "finds"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Max finds to return. Default 100, capped at 200."
                }
              ]
            },
            "description": "Every successful `/v1/identify` by a signed-in user records the top investable as a find. Returns finds newest-first.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Progression (XP, level, streak) for the signed-in user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "Server-side truth for XP, level, streak length, and streak-freeze inventory. Written by `recordFind` on every successful `/v1/identify`; the client renders this rather than deriving a streak locally, so the streak survives reinstall. `lastFindDay` is a UTC calendar day (`YYYY-MM-DD`).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Counterfactual universe portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/universe/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "universe",
                "summary"
              ]
            },
            "description": "The `$100 per find at found price` aggregate: what the caller's universe would be worth if $100 had gone into every find at the moment it was found. Computed from each find's `foundPrice` against the current quote. Finds without a `foundPrice` are excluded from the valued totals, never estimated (AGENTS.md §2.4). Hypothetical only — not a holdings statement. `sources` cites each quote provider that actually declared itself, with confidence derived from the quote's own freshness declaration (AGENTS.md §6 — a quote reporting no provider adds no citation rather than a fabricated one).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Collection progress (sector dexes + regional tiles)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/dex",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dex"
              ]
            },
            "description": "Derived on read by reconciling the caller's finds against the `brands.json` seed in `packages/finance`: per-sector found/total counts, plus `tilesVisited` (distinct geohash-6 tiles with at least one find). Rarity tiers are enumerated by the `DexRarity` component.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sessionToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
