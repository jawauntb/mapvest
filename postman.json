            ],
            "url": {
              "raw": "{{baseUrl}}/v1/resolve-comparable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "resolve-comparable"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"\",\n  \"hintSector\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Given a brand name, returns the closest public comparable, ETF exposures, and cited sources. Confidence is `low` when the pipeline could not cite a source (do not fabricate).",
